<?xml version="1.0" encoding="utf-8"?>
<!--
    Backups are disabled (allowBackup=false). These rules additionally exclude everything for
    Android 11 and lower: SMS history and webhook credentials must never leave the device, and
    Keystore-encrypted secrets could not be decrypted on another device anyway.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
